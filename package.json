{
  "name": "@cedricziel/aha-mcp",
  "module": "src/index.ts",
  "type": "module",
  "version": "5.0.0",
  "description": "Model Context Protocol (MCP) Server for Aha",
  "private": false,
  "main": "./build/index.js",
  "bin": {
    "aha-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aha",
    "aha-io",
    "product-management",
    "ai",
    "claude"
  ],
  "author": "Cedric Ziel <cedric@cedric-ziel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricziel/aha-mcp.git"
  },
  "homepage": "https://github.com/cedricziel/aha-mcp#readme",
  "bugs": {
    "url": "https://github.com/cedricziel/aha-mcp/issues"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir build --target node",
    "dev": "bun --watch src/index.ts",
    "start:http": "bun run src/index.ts --mode streamable-http",
    "dev:http": "bun --watch src/index.ts --mode streamable-http",
    "test": "bun test --env-file=/dev/null",
    "test:watch": "bun test --watch --env-file=/dev/null",
    "prepublishOnly": "bun run build",
    "prepare": "husky",
    "manifest:sync": "bun run scripts/sync-manifest.ts",
    "manifest:check": "bun run scripts/sync-manifest.ts --check",
    "bench:scramble": "bun run scripts/bench/scramble.ts",
    "bench:size": "bun run scripts/bench/size.ts",
    "bench:serve": "bun run scripts/bench/serve.ts",
    "bench:questions": "bun run scripts/bench/generate-questions.ts",
    "bench:agent-run": "bun run scripts/bench/agent-run.ts",
    "mcpb:validate": "mcpb validate manifest.json",
    "mcpb:pack": "bun run build && mcpb pack . dist/aha-mcp.mcpb",
    "docker:build": "docker build -t ghcr.io/cedricziel/aha-mcp .",
    "docker:run": "docker run --rm -e AHA_COMPANY=${AHA_COMPANY} -e AHA_TOKEN=${AHA_TOKEN} ghcr.io/cedricziel/aha-mcp",
    "docker:test": "docker run --rm ghcr.io/cedricziel/aha-mcp --help",
    "docker:run:http": "docker run --rm -p 3001:3001 -e AHA_COMPANY=${AHA_COMPANY} -e AHA_TOKEN=${AHA_TOKEN} ghcr.io/cedricziel/aha-mcp --mode streamable-http"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@cedricziel/aha-js": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "4.4.3"
  }
}
