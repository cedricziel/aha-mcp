node_modules/

# Local credentials. .env.example directs you to put AHA_TOKEN here, so it must never
# be committed; .env.example itself is tracked and holds placeholders only.
.env
.env.*
!.env.example

.clinefile
.claude/
build/
dist/
package-lock.json

# MCP bundle packaging (.dxt was the pre-rename extension format)
*.dxt
*.mcpb
.dxt-cache/

# scripts/bench/ derives from real Aha account data. Fixtures are captured locally to
# ~/.cache/aha-mcp-bench/, never here; questions.json is generated from them by
# `bun run bench:questions` and regenerated on demand, not committed.
scripts/bench/fixtures/
scripts/bench/questions.json
